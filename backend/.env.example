DATABASE_URL=
VIRUSTOTAL_API_KEY=
ALLOWED_ORIGIN=

# Rate limiting — maximum scans a single IP may perform per hour.
# Default 10 for production; set higher for demos (e.g. 500).
RATE_LIMIT_PER_HOUR=10

# Number of trusted reverse-proxy hops between the internet and this server.
# Render's own edge proxy counts as 1; a CDN in front adds another.
# Used to pick the right entry from X-Forwarded-For (index -N).
# Default 2 (Render + its load-balancer).
TRUSTED_PROXY_HOPS=2

# Local development only; never set in production
ALLOW_PRIVATE_TARGETS=
