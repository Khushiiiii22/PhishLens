{
  "model_name": "Character-Level CNN",
  "model_type": "deep-learning-char-cnn",
  "description": "Character-level 1D-CNN trained directly on raw URL text. No hand-crafted features \u2014 the model learns character-level patterns (suspicious substrings, domain tricks, etc.) end-to-end from data.",
  "architecture": {
    "input": "URL encoded as 200-length integer sequence",
    "layers": [
      "Embedding(vocab_size=92, dim=32)",
      "Conv1D(filters=64, kernel_size=5, relu)",
      "GlobalMaxPooling1D",
      "Dense(64, relu)",
      "Dropout(0.3)",
      "Dense(1, sigmoid)"
    ]
  },
  "training": {
    "optimizer": "adam",
    "loss": "binary_crossentropy",
    "epochs_trained": 10,
    "max_epochs": 20,
    "batch_size": 64,
    "early_stopping_patience": 3,
    "validation_split": 0.15
  },
  "vocab": {
    "vocab_size": 92,
    "max_url_len": 200,
    "file": "char_vocab.json"
  },
  "label_encoding": {
    "legitimate": 0,
    "phishing": 1
  },
  "dataset_size": 11430,
  "train_size": 9144,
  "test_size": 2286,
  "metrics": {
    "Accuracy": 0.9226,
    "Precision": 0.929,
    "Recall": 0.9151,
    "F1-Score": 0.922,
    "FPR": 0.07,
    "ROC-AUC": 0.9739
  },
  "baseline_comparison": {
    "baseline_model": "Random Forest",
    "baseline_metrics": {
      "Accuracy": 0.8097,
      "Precision": 0.8327,
      "Recall": 0.7752,
      "F1-Score": 0.8029,
      "FPR": 0.1557,
      "ROC-AUC": 0.8889,
      "Train Time": "0.33s"
    }
  },
  "files": {
    "model": "deep_model.h5",
    "vocabulary": "char_vocab.json",
    "metadata": "deep_metadata.json"
  }
}